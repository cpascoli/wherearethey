{
  "name": "wherearethey",
  "version": "0.1.0",
  "private": true,
  "description": "A navigable knowledge map of UAP / NHI research notes",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "check:news": "node scripts/check-news.mjs",
    "watchlist": "node scripts/watchlist.mjs",
    "fetch": "node scripts/fetch-video.mjs",
    "find": "node scripts/find.mjs",
    "dvids:thumbs": "node scripts/dvids-thumbs.mjs",
    "import:pursue": "node scripts/import-pursue.mjs",
    "add:doc": "node scripts/add-document.mjs",
